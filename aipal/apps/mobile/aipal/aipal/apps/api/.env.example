SEMANTIC_ENDPOINTING_MIN_CONFIDENCE=0.55
SEMANTIC_ENDPOINTING_CODE_SWITCH_THRESHOLD=0.65
SEMANTIC_ENDPOINTING_PRODUCTION_FALLBACK_POLICY=fail_closed
SEMANTIC_ENDPOINTING_MIN_WAIT_MS=240
SEMANTIC_ENDPOINTING_MAX_WAIT_MS=1400
NEURAL_VAD_PROVIDER=silero_v6
NEURAL_VAD_MODEL_VERSION=silero-v6-faster-whisper
NEURAL_VAD_DEVICE=cpu
NEURAL_VAD_SAMPLE_RATE=16000
NEURAL_VAD_FRAME_MS=40
NEURAL_VAD_START_THRESHOLD=0.55
NEURAL_VAD_END_THRESHOLD=0.35
NEURAL_VAD_START_MIN_MS=64
NEURAL_VAD_THINKING_PAUSE_MS=320
NEURAL_VAD_PREROLL_MS=320
NEURAL_VAD_MAX_UTTERANCE_MS=20000
NEURAL_VAD_INFERENCE_TIMEOUT_SECONDS=0.02
NEURAL_VAD_FALLBACK_MODE=adaptive_energy_development_only
NEURAL_VAD_PRODUCTION_FALLBACK_POLICY=fail_closed
NEURAL_VAD_ECHO_SUPPRESSION_ENABLED=true
NEURAL_VAD_ECHO_START_THRESHOLD=0.72
NEURAL_VAD_DIAGNOSTICS_ENABLED=true
TOPIC_CLASSIFIER_PROVIDER=semantic_local
TOPIC_CLASSIFIER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOPIC_CLASSIFIER_MODEL_VERSION=topic-transition-v1
TOPIC_CLASSIFIER_DEVICE=cpu
TOPIC_CLASSIFIER_MIN_CONFIDENCE=0.62
TOPIC_CLASSIFIER_AMBIGUITY_THRESHOLD=0.12
TOPIC_CLASSIFIER_TIMEOUT_SECONDS=0.025
TOPIC_CLASSIFIER_MAX_PAUSED_TOPICS=5
TOPIC_CLASSIFIER_TOPIC_EXPIRY_SECONDS=86400
TOPIC_CLASSIFIER_CONFIRMATION_EXPIRY_SECONDS=1800
TOPIC_CLASSIFIER_SAME_TOPIC_SIMILARITY=0.62
TOPIC_CLASSIFIER_RELATED_SIMILARITY=0.42
TOPIC_CLASSIFIER_UNRELATED_SIMILARITY=0.30
TOPIC_CLASSIFIER_RESUME_SIMILARITY=0.58
TOPIC_CLASSIFIER_FALLBACK_MODE=safe_ambiguous
TOPIC_CLASSIFIER_PRODUCTION_FALLBACK_POLICY=fail_closed
TOPIC_CLASSIFIER_DIAGNOSTICS_ENABLED=true
LIVE_VOICE_V2=true
LIVE_TURNS_PER_MINUTE=20
MEM0_ENABLED=false
