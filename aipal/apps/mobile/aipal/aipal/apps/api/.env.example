OLLAMA_NUM_PREDICT=72
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=12
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
MAX_AUDIO_DECODE_SECONDS=12
TTS_PROVIDER=edge
TTS_TIMEOUT_SECONDS=6
STT_PROVIDER=whisper_stream
WHISPER_STREAM_PARTIAL_INTERVAL_MS=500
SEMANTIC_ENDPOINTING_PROVIDER=multilingual_semantic
SEMANTIC_ENDPOINTING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_ENDPOINTING_MODEL_SOURCE=huggingface:qdrant/fastembed-onnx
SEMANTIC_ENDPOINTING_MODEL_DEVICE=cpu
SEMANTIC_ENDPOINTING_MODEL_CACHE_PATH=.cache/endpointing
SEMANTIC_ENDPOINTING_SUPPORTED_LANGUAGES=en,pcm,fr
SEMANTIC_ENDPOINTING_FALLBACK_MODE=language_agnostic
