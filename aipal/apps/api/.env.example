# AiPal API Backend Environment Configuration Example
DATABASE_PATH=./instance/app.db
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
AIPAL_ENV=development
MAGIC_LINK_DEV_RETURN_TOKEN=true

# LLM & Voice Provider Credentials
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=18
DEEPSEEK_MAX_TOKENS=220
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=18
OPENAI_MAX_TOKENS=220

# Audio & Speech Processing
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
MAX_AUDIO_DECODE_SECONDS=12
TTS_PROVIDER=edge
TTS_TIMEOUT_SECONDS=6
STT_PROVIDER=whisper_stream
WHISPER_STREAM_PARTIAL_INTERVAL_MS=500
LIVE_VOICE_V2=true
LIVE_TURNS_PER_MINUTE=20

# Memory & Redis Setup
MEM0_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CONTEXT_CACHE_TTL_SECONDS=180

# Notifications & SMTP Configuration
NOTIFICATION_DISPATCHER_ENABLED=true
NOTIFICATION_DISPATCHER_INTERVAL_SECONDS=30
EMAIL_NOTIFICATIONS_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aipal.local
SMTP_USE_TLS=true

# Litestream S3 Backup Credentials
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# WSGI Server & CORS Config
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:8102
CORS_ORIGINS=*
